# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Local dev tools / test harnesses (contain personal/internal server details)
tools/

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
credentials.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Claude Code
.claude/settings.local.json
.claude/scheduled_tasks.lock
.mcp.json

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# release script temp file
.release-notes-tmp

# saved plans
plans/

# test coverage
coverage/

# typescript
*.tsbuildinfo

# local module build output
modules/*/android/build/
modules/*/ios/build/

# generated native folders
/ios
/android
FEATURES.md

# ruby / bundler
vendor/
Gemfile.lock

# fastlane
fastlane/.env
fastlane/.api_key.json
fastlane/.metadata_push
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output
play-store-key.json

# Private journal (local thinking notes, never committed)
.private-journal/
# --- AI assistant files (local only, never published) ---
# Anchored entries (/NAME) are root-only on purpose: a nested AGENTS.md or
# CLAUDE.md can belong to the project's own content and must stay tracked.
.claude/
/CLAUDE.md
/CLAUDE.local.md
/AGENTS.md
/GEMINI.md
.gemini/
.codex/
.cursor/
.cursorrules
.cursorignore
.aider*
.continue/
.windsurf/
.windsurfrules
.clinerules
.roo/
.roomodes
.devin/
.specstory/
.github/copilot-instructions.md
# --- leak-guard baseline: do not edit between the markers ---
# Assistant state directories, matched at any depth.
.antigravity/
.codeium/
.cline/
.sourcegraph/
.cody/
.tabnine/
.amazonq/
.junie/
.qodo/
.openhands/
.goose/
.kilocode/
.augment/
.trae/
.bolt/
.opencode/
.crush/
.factory/
.amp/
.codebuff/
.agent-os/
.taskmaster/
.copilot/
# Instruction and config files, ROOT-ANCHORED: a nested AGENTS.md or CLAUDE.md can be
# the project's own content (tuya-local ships one under custom_components/).
/AGENT.md
/.cursorrules
/.cursorignore
/.cursorindexingignore
/.windsurfrules
/.clinerules
/.roomodes
/.rooignore
/.aider.conf.yml
/.aiderignore
/.augmentignore
/.gptignore
/.llmignore
/.airules
/.mcp.json
/.github/copilot-instructions.md
# Chat transcripts — the highest-value leak in the category.
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*/
repomix-output.*
# Coverage and test caches: an absolute path in every record.
.coverage
.coverage.*
coverage.xml
htmlcov/
lcov.info
.pytest_cache/
.tox/
.nox/
# Type and lint caches.
.mypy_cache/
.ruff_cache/
# Build output: embeds the build root.
build/
*.egg-info/
*.sarif
# Environments: absolute paths in every script shebang.
.venv/
venv/
env/
__pycache__/
*.py[cod]
# Secrets. The negations are mandatory: six repos track a .env.example on purpose.
.env.*
!.env.example
!.env.template
# Editor and OS. koel tracks a .vscode/mcp.json — editor dirs are becoming assistant dirs.
.vscode/
.idea/
.zed/
*.swp
*.swo
Thumbs.db
# --- end leak-guard baseline ---
